        <mxCell id="note0" value="&lt;div&gt;PK = primary key | FK = foreign key | PK/FK = both | UQ = unique | ? = nullable&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1290" width="1510" height="22" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="&lt;div&gt;Each parent has 0..N children; each child references exactly 1 parent (NOT NULL FK).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1312" width="1510" height="22" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;div&gt;Composite PK prevents duplicate user/movie, movie/genre and user/genre pairs.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1334" width="1510" height="22" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;div&gt;Ratings: 0.5..5.0, step 0.5. Progress: seconds &amp;gt;= 0; duration bound checked by service.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1356" width="1510" height="22" as="geometry" />
        </mxCell>
