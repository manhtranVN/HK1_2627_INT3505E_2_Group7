        <mxCell id="tree-note0" value="&lt;div&gt;Core: GET /api/v1/health → HealthStatus. Các node AI màu tím chỉ là ngữ cảnh dự kiến, chưa có operation trong contract.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="2220" width="2150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tree-note1" value="&lt;div&gt;Method lấy từ OpenAPI hiện tại; node namespace không tạo endpoint mới. /auth/login và /auth/register là ngoại lệ thao tác auth được giữ nguyên.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="2262" width="2150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tree-note2" value="&lt;div&gt;Không đưa users, movie_genres hay user_genre_preferences thành endpoint chỉ vì tồn tại bảng DB.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="2304" width="2150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tree-note3" value="&lt;div&gt;Trang 02 trình bày JSON representation và tham chiếu; trang 01 không mô tả FK, deployment hay luồng thao tác của người dùng.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=18;fontColor=#334155;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="2346" width="2150" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
